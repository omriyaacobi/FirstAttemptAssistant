# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# From Google Cloud console -> APIs & Services -> Credentials -> your Desktop OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: encrypted backup of data/ (see backup.js). BOT_BACKUP_DIR is a folder INSIDE OneDrive / Google Drive
# for desktop (its parent must already exist). The passphrase is at least 12 characters: YOU choose it, and keep a
# copy outside this PC (password manager / paper), because .env is lost if the PC dies. BOT_BACKUP_KEEP: copies to keep (default 5).
BOT_BACKUP_DIR=
BOT_BACKUP_PASSPHRASE=
BOT_BACKUP_KEEP=5

# Optional: ONE continuous conversation instead of a list of chats (see PROGRESS.md "The thread"). Default off: Bot is then exactly
# what it was. Before turning it on run:  node backup.js run   then   node thread.js import   and   node thread.js verify-import
# (all three, in this order). To go back set it to off and restart Bot.
BOT_THREAD=off

# Moodle: NOT used now. BGU's site refuses scripts at its edge, so Bot reads Moodle through Chrome (moodle-extension/, no password
# needed). Only for experiments/moodle-probe.js if that ever changes. Type them yourself; never commit .env.
MOODLE_USER=
MOODLE_PASS=
