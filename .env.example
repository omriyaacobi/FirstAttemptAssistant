# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# From Google Cloud console -> APIs & Services -> Credentials -> your Desktop OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: encrypted backup of data/ (see backup.js). BOT_BACKUP_DIR is a folder INSIDE OneDrive / Google Drive
# for desktop (its parent must already exist). The passphrase is at least 12 characters: YOU choose it, and keep a
# copy outside this PC (password manager / paper), because .env is lost if the PC dies. BOT_BACKUP_KEEP: copies to keep (default 5).
BOT_BACKUP_DIR=
BOT_BACKUP_PASSPHRASE=
BOT_BACKUP_KEEP=5


# Moodle read token (moodle-ws.js). Do NOT type it here by hand: run `node moodle-token.js` once; it asks for your Moodle user
# name and password (sent to Moodle only, never saved) and writes this line itself. A secret: never commit or share it.
# Without it Bot reads Moodle through Chrome (moodle-extension/) while you are logged in there.
MOODLE_TOKEN=
# NOT used by Bot. Only for the old experiments/moodle-probe.js.
MOODLE_USER=
MOODLE_PASS=
